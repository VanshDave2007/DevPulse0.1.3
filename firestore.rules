rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User documents and nested collections: only accessible by the authenticated owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /analysisHistory/{analysisId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /aiHistory/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /savedSnippets/{snippetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /workspaceIntegrations/{integrationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
